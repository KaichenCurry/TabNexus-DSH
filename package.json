{
  "name": "dsh-plugin-tabnexus",
  "version": "0.2.0",
  "description": "TabNexus for DSH（独立版）：零 Chrome 依赖的浏览器任务上下文插件。任务文档、自由章节、四态页面、进度、导出、全局工作区 UI，装完即用。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-runtime"], "platform": "web" }
  },
  "keywords": ["dsh-plugin", "tabnexus", "browser", "tabs", "task-context", "deepseek-harness"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/KaichenCurry/TabNexus-DSH.git" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "lightningcss": "^1.29.0",
    "tsdown": "0.22.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  }
}
